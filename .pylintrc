# Конфигурация pylint. Каждое отступление от умолчаний объяснено: молчаливо
# отключённая проверка — это спрятанный долг, а не решённая проблема.

[MAIN]
py-version = 3.11
jobs = 0
ignore-paths = ^\.git/.*$

[MESSAGES CONTROL]
disable =
    # Событие, конверт, карта — это данные. Требовать от них два публичных
    # метода значит требовать выдумывать методы.
    too-few-public-methods,
    # Игры намеренно похожи по форме: один контракт, одинаковый скелет
    # start/handle/tick. Совпадения здесь — признак единообразия, а не копипасты.
    duplicate-code,

[BASIC]
# Короткая функция документируется своим именем. Докстрока к `def has_key`
# из трёх слов, повторяющих сигнатуру, делает код длиннее, а не понятнее,
# поэтому требуем её только там, где есть что объяснить.
docstring-min-length = 12

# Приватные методы (^_) освобождены по умолчанию; сюда добавлены реализации
# контракта Game и dunder-методы — их смысл задан протоколом в api.py.
no-docstring-rgx = ^_|^(start|handle|tick|encode|decode|to_json|from_json|render)$

good-names = i, j, k, n, e, s, h, ck, rs, re, p, ad, kp, fh, id

[FORMAT]
max-line-length = 100

[DESIGN]
# Пределы подняты осознанно и не безгранично.
#
# Прежде здесь стояла оговорка про Mesh с восемнадцатью полями — сигнал, а не
# придирка линтера. Долг закрыт: класс разделён на PeerNetwork (соединения и
# доверие) и Mesh (сообщения и файлы). Пределы оставлены с запасом, но уже не
# прикрывают конкретный перегруженный класс.
max-attributes = 16
max-args = 9
max-positional-arguments = 6
max-locals = 20
max-returns = 10
max-branches = 15
max-statements = 60

[TYPECHECK]
# У asyncio-транспортов часть атрибутов появляется динамически.
ignored-classes = asyncio.DatagramTransport, asyncio.StreamWriter

[VARIABLES]
# Аргумент, который есть ради интерфейса, но не нужен реализации, называем
# с подчёркиванием: это видно в сигнатуре, в отличие от подавления проверки.
dummy-variables-rgx = ^_.*$
ignored-argument-names = ^_.*$
